# Copy to .env and fill in your own values. Never commit the real .env.
PORT=8787
HOST=127.0.0.1

# Zernio webhook signing secret (X-Zernio-Signature, HMAC-SHA256 hex).
ZERNIO_WEBHOOK_SECRET=replace_with_your_zernio_signing_secret

# Inbox allow-list. Comma-separated usernames, case-insensitive.
# Empty on both sides accepts everything.
ALLOW_SENDER_USERNAMES=allowed_sender_username
ALLOW_RECEIVER_USERNAMES=allowed_receiver_username

# Optional SQLite path (defaults to data/inbox.db).
DB_PATH=data/inbox.db

# Optional downstream receiver for the raw event; leave empty to disable.
DOWNSTREAM_URL=
DOWNSTREAM_TOKEN=
